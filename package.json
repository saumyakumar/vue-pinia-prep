{
  "name": "vue-pinia-prep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A guided Vue 3 + Pinia learning project targeted at a Business Insights / analytics-dashboard role.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --ext .js,.vue",
    "lint:fix": "eslint . --ext .js,.vue --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css}\" \"tests/**/*.js\""
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "d3": "^7.9.0",
    "echarts": "^6.1.0",
    "pinia": "^3.0.1",
    "pinia-plugin-persistedstate": "^4.2.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^10.0.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "jsdom": "^26.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.4.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
